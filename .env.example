# .env.example — переменные окружения для docker-compose acuity-yolo.
# Скопируйте в .env и поправьте под себя.

# ── Выбор образа (DEVICE) и модели (MODEL) ──
# Образ в GHCR тегируется как worker:<device>-<model>, напр.:
#   ghcr.io/trahomich/acuity-yolo/worker:gpu-amd-m
#   ghcr.io/trahomich/acuity-yolo/worker:gpu-amd-l
#   ghcr.io/trahomich/acuity-yolo/worker:gpu-amd-x
#   ghcr.io/trahomich/acuity-yolo/worker:cpu-m / cpu-l / cpu-x
# DEVICE и MODEL задают тег образа в docker-compose.yml. Переключение модели —
# просто смена MODEL в .env + docker compose pull (без пересборки).
DEVICE=gpu-amd
MODEL=m

# EXECUTION_PROVIDER — должно совпадать с DEVICE: gpu-amd→rocm, cpu→cpu.
EXECUTION_PROVIDER=rocm

# GID группы render на хосте. Узнать: getent group render (или stat -c %g /dev/kfd).
# Нужно для доступа к AMD GPU из контейнера. По умолчанию 992 (типично для ROCm-хостов).
RENDER_GID=992

# ── Runtime-параметры воркера ──
CONF_THRESHOLD=0.4
IOU_THRESHOLD=0.5
INPUT_SIZE=640
LOG_LEVEL=info
# MODEL_NAME/MODEL_PATH должны соответствовать тегу образа:
#   MODEL=m → yolov12m / models/yolov12m.onnx
#   MODEL=l → yolov12l / models/yolov12l.onnx
#   MODEL=x → yolov12x / models/yolov12x.onnx
MODEL_NAME=yolov12m
MODEL_PATH=models/yolov12m.onnx

# Число uvicorn-воркеров (параллельный инференс). Каждый грузит свою копию
# модели в RAM (~700МБ для m, ~1.5ГБ для x). По умолчанию 1; для нагрузки
# поднимать с учётом RAM-лимита контейнера. Альтернатива — --scale реплик.
UVICORN_WORKERS=1

# Хост-порт для доступа к воркеру снаружи (для inference-service на другом сервере).
WORKER_HTTP_PORT=9104
