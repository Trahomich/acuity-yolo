# .env.example — переменные окружения для docker-compose acuity-yolo.
# Скопируйте в .env и поправьте под себя.

# Build-аргументы (этап экспорта модели в Dockerfile).
EXPORT_MODEL=1
MODEL_SPEC=yolov12n.pt
IMGSZ=640

# Runtime-параметры воркера (приоритет над configs/worker.yml).
EXECUTION_PROVIDER=cpu
CONF_THRESHOLD=0.4
IOU_THRESHOLD=0.5
INPUT_SIZE=640
MODEL_NAME=yolov12n
MODEL_PATH=models/yolov12n.onnx
LOG_LEVEL=info

# Хост-порт для доступа к воркеру снаружи (для inference-service на другом сервере).
WORKER_HTTP_PORT=9104
