# .env.example — переменные окружения для docker-compose acuity-yolo.
# Скопируйте в .env и поправьте под себя.

# Build-аргументы (этап экспорта модели в Dockerfile).
EXPORT_MODEL=1
MODEL_SPEC=yolo12m.pt
IMGSZ=640

# Устройство для инференса:
#   rocm — AMD GPU (собирает onnxruntime-rocm, пробрасывает /dev/kfd /dev/dri).
#   cpu  — обычный onnxruntime (без GPU).
# DEVICE и EXECUTION_PROVIDER должны совпадать.
DEVICE=rocm
EXECUTION_PROVIDER=rocm

# GID группы render на хосте. Узнать: getent group render (или stat -c %g /dev/kfd).
# Нужно для доступа к AMD GPU из контейнера. По умолчанию 992 (типично для ROCm-хостов).
RENDER_GID=992

# Runtime-параметры воркера (приоритет над configs/worker.yml).
CONF_THRESHOLD=0.4
IOU_THRESHOLD=0.5
INPUT_SIZE=640
MODEL_NAME=yolov12m
MODEL_PATH=models/yolov12m.onnx
LOG_LEVEL=info

# Хост-порт для доступа к воркеру снаружи (для inference-service на другом сервере).
WORKER_HTTP_PORT=9104
